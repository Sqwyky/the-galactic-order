# THE GALACTIC ORDER — Environment Configuration
# Copy to .env and customize

NODE_ENV=development
PORT=3000

# JWT secret (auto-generated if not set, but set one for persistent sessions)
# JWT_SECRET=your-secret-here
# JWT_EXPIRES_IN=7d

# Database path (SQLite)
# DB_PATH=./server/db/galactic-order.sqlite

# CORS origin (use specific origin in production)
# CORS_ORIGIN=*
